<?xml version="1.0" encoding="ISO-8859-1"?>

<alg_conf>

<!--
Configuration for the NewQELXSec xsec algorithm.

Configurable Parameters:
.....................................................................................................
Name                         Type     Optional   Comment                                      Default

gsl-integration-type         string   Yes        name of GSL multidimensional integrator      adaptive

AverageOverNucleons          bool     Yes        whether to do an MC integration over the     true
                                                 initial state nuclear model when computing
                                                 the total cross section
.....................................................................................................
-->

  <param_set name="Default">
    <param type="string" name = "gsl-integration-type"> adaptive </param>
    <param type="double" name = "gsl-relative-tolerance"> 0.0001 </param>
    <param type="int" name = "gsl-max-eval"> 100000 </param>
    <param type="alg" name = "VertexGenAlg"> genie::VertexGenerator/Default </param>
    <param type="int" name = "NumNucleonThrows"> 500 </param>
    <!-- Effective only when GPU acceleration is enabled. Supported: Llewellyn-Smith CCQE with
         BBA07 elastic + dipole axial FF, and Nieves NoRPA with BBA07 + Z-expansion.
         Nuclear sampling and the Nieves Coulomb potential remain on CPU.
         Unconverged angular integrals use the original CPU integrator on
         the same sampled nucleon. False forces the historical CPU path. -->
    <param type="bool" name = "UseGPUIntegration"> true </param>
    <!-- Enabled by default for GPU integration; false opts out. The additional
         evaluation budget applies per nucleon, after gsl-max-eval. Values
         at or below zero disable additional work. CPU fallback remains. -->
    <param type="bool" name = "UseGPUAdaptiveIntegration"> true </param>
    <param type="int" name = "GPUAdaptiveMaxEval"> 100000 </param>
  </param_set>


  <!-- Omits the MC integration over nucleons for use in "QE shape" reweighting -->
  <param_set name="ReweightShape">
    <param type="bool" name = "AverageOverNucleons"> false </param>
  </param_set>

</alg_conf>
